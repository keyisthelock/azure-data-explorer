# EXAMPLE FILE - PLACEHOLDERS ONLY. Do not put real values in this file.
#
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace the placeholder values with YOUR OWN Azure SQL details
# 3. Never commit secrets.toml (it is already listed in .gitignore)

[azure_sql]
server   = "your-server-name.database.windows.net"
database = "your-database-name"
username = "your-sql-username"
password = "your-password-here"
