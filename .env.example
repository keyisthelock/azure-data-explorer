# EXAMPLE FILE - PLACEHOLDERS ONLY.
# Alternative to .streamlit/secrets.toml: set these as environment variables
# in your terminal (see README, "Option B"). The app does not read a .env
# file automatically; this file just lists the variable names.
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USERNAME=your-sql-username
AZURE_SQL_PASSWORD=your-password-here
